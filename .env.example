# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer the publishable key; anon key still works for local/dev compatibility
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Knowledge upload limits (bytes). Default 10MB.
KNOWLEDGE_MAX_FILE_BYTES=10485760

# Media upload limits for Analyze / My Content (bytes). Default 100MB.
MEDIA_MAX_FILE_BYTES=104857600

# Optional: app URL used for auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future AI providers (not required for Phase 0–1B foundation)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
