# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer the publishable key; anon key still works for local/dev compatibility
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Knowledge upload limits (bytes). Default 10MB.
KNOWLEDGE_MAX_FILE_BYTES=10485760

# Media upload limits for Analyze / My Content (bytes). Default 100MB.
MEDIA_MAX_FILE_BYTES=104857600

# Optional: app URL used for auth redirects + OAuth callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public contact address shown on /terms and /privacy.
# Platform API reviews (TikTok, Meta) require a real, monitored inbox here.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Growth Phase F.5: Social Connections (owned accounts) ---
# Encrypt OAuth tokens at rest (required before any Connect flow succeeds).
# Generate: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Optional dedicated HMAC secret for OAuth state (falls back to encryption key)
SOCIAL_OAUTH_STATE_SECRET=

# Instagram (Meta Instagram API with Instagram Login — professional accounts)
META_APP_ID=
META_APP_SECRET=
# Optional overrides
# INSTAGRAM_LOGIN_CONFIG_ID=
# META_GRAPH_API_VERSION=v21.0
# Callback: {NEXT_PUBLIC_APP_URL}/api/social/instagram/callback

# YouTube (Google OAuth + YouTube Data API; Analytics when scoped)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: {NEXT_PUBLIC_APP_URL}/api/social/youtube/callback

# TikTok (Login Kit / Display API — only approved scopes)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Callback: {NEXT_PUBLIC_APP_URL}/api/social/tiktok/callback

# --- Growth G1.5: OpenRouter + budgets (server-only) ---
OPENROUTER_API_KEY=

# Preferred aliases (fall back to OPENROUTER_* if unset)
AI_MODEL_CHEAP=openai/gpt-4o-mini
AI_MODEL_STANDARD=openai/gpt-4o-mini
AI_MODEL_PREMIUM=anthropic/claude-sonnet-4
AI_MODEL_MULTIMODAL=openai/gpt-4o-mini

# Legacy aliases still supported
OPENROUTER_CHEAP_MODEL=openai/gpt-4o-mini
OPENROUTER_STANDARD_MODEL=openai/gpt-4o-mini
OPENROUTER_PREMIUM_MODEL=anthropic/claude-sonnet-4

DAILY_AI_BUDGET_USD=1
MONTHLY_AI_BUDGET_USD=10
AI_MAX_RETRIES=2

# --- Research Radar / Growth H discovery (server-only) ---
# Enables official public YouTube niche searches. This is not your YouTube OAuth secret.
YOUTUBE_DATA_API_KEY=
# Fixture discovery provider for local/dev (never claims live platform data).
RESEARCH_ENABLE_DEMO=
# Discovery provider call budgets (metadata search only; deep AI stays opt-in).
DISCOVERY_DAILY_CALL_BUDGET=50
DISCOVERY_MONTHLY_CALL_BUDGET=500
DISCOVERY_MAX_RESULTS_PER_QUERY=25
DISCOVERY_MAX_TRACKED_CREATORS=50
# Keep OFF unless you explicitly want auto deep analysis (expensive).
DISCOVERY_AUTO_DEEP_ANALYSIS=
# Required only when deploying the daily Research Radar cron endpoint.
CRON_SECRET=
AI_DEFAULT_TIMEOUT_MS=45000

# Future direct providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
